---
import WidgetLayout from "@/components/common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

const gameWidth = 260;
const gameHeight = 140;
const worldWidth = 520;
---

<WidgetLayout id="graph-game" name="Game console" class={`graph-game-widget ${className || ""}`} style={style}>
  <div class="relative">
    <canvas id="mini-platformer" width={gameWidth} height={gameHeight} class="w-full h-[160px] rounded-lg border border-black/10 dark:border-white/15 bg-white/60 dark:bg-black/30"></canvas>
    <div class="mt-2 flex gap-2">
      <button id="mini-start" class="h-4 w-4 rounded-full bg-[#34C759] shadow-[inset_0_1px_0_rgba(255,255,255,0.6),0_1px_2px_rgba(0,0,0,0.12)] ring-1 ring-black/10 hover:brightness-110 transition" title="开始"></button>
      <button id="mini-pause" class="h-4 w-4 rounded-full bg-[#FFCC00] shadow-[inset_0_1px_0_rgba(255,255,255,0.6),0_1px_2px_rgba(0,0,0,0.12)] ring-1 ring-black/10 hover:brightness-110 transition" title="暂停"></button>
      <button id="mini-reset" class="h-4 w-4 rounded-full bg-[#FF3B30] shadow-[inset_0_1px_0_rgba(255,255,255,0.6),0_1px_2px_rgba(0,0,0,0.12)] ring-1 ring-black/10 hover:brightness-110 transition" title="重开"></button>
    </div>
    <div id="mini-win" class="mt-2 text-xs text-[var(--primary)] hidden">
      “Thanks for playing my game.”
    </div>
  </div>
</WidgetLayout>

<script is:inline define:vars={{ gameWidth, gameHeight, worldWidth }}>
  (function() {
    const canvas = document.getElementById('mini-platformer');
    const startBtn = document.getElementById('mini-start');
    const pauseBtn = document.getElementById('mini-pause');
    const resetBtn = document.getElementById('mini-reset');
    const win = document.getElementById('mini-win');
    if (!canvas || !startBtn || !pauseBtn || !resetBtn || !win) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const player = { x: 16, y: 96, w: 10, h: 12, vx: 0, vy: 0, onGround: false };
    const gravity = 0.6;
    const speed = 2.1;
    const jump = -7.6;
    const maxJump = -10.4;
    let platforms = [
      { x: 0, y: 120, w: 400, h: 20, type: 'solid', broken: false, drop: 0, t: 0, dir: 1, ox: 0 },
    ];
    let coins = [];
    let enemies = [];
    let springs = [];
    let meteors = [];
    let boss = { active: false, tier: 0, x: 0, y: 90, w: 28, h: 28, vx: 0, vy: 0, onGround: false, timer: 0, speed: 0.85, jump: -6.2 };
    let running = false;
    let collected = 0;
    let fails = 0;
    let lives = 2;
    let showFailGlow = false;
    let failGlowTimer = 0;
    let gameOver = false;
    const keys = new Set();
    let charging = false;
    let jumpCharge = 0;
    const maxCharge = 28;
    let cameraX = 0;
    let worldEnd = 400;
    let colorTimer = 0;
    const colors = ['#22c55e', '#3b82f6', '#f59e0b', '#ef4444', '#a855f7'];
    const stars = Array.from({ length: 60 }, () => ({
      x: Math.random() * (gameWidth * 3),
      y: Math.random() * (gameHeight * 0.75),
      r: Math.random() * 0.9 + 0.3,
      a: Math.random() * 0.5 + 0.4
    }));
    const nebulas = Array.from({ length: 5 }, () => ({
      x: Math.random() * (gameWidth * 3),
      y: Math.random() * (gameHeight * 0.6),
      r: 18 + Math.random() * 30,
      a: Math.random() * 0.2 + 0.08
    }));

    function reset() {
      player.x = 16; player.y = 96; player.vx = 0; player.vy = 0; player.onGround = false;
      platforms = [{ x: 0, y: 120, w: 400, h: 20, type: 'solid', broken: false, drop: 0, t: 0, dir: 1, ox: 0 }];
      coins = [];
      enemies = [];
      springs = [];
      meteors = [];
      boss = { active: false, tier: 0, x: 0, y: 90, w: 28, h: 28, vx: 0, vy: 0, onGround: false, timer: 0, speed: 0.85, jump: -6.2 };
      worldEnd = 400;
      cameraX = 0;
      collected = 0;
      lives = 2;
      fails = 0;
      showFailGlow = false;
      failGlowTimer = 0;
      gameOver = false;
      colorTimer = 0;
      win.classList.add('hidden');
      if (fails >= 5) {
        win.textContent = "别再玩了，快去工作吧";
        win.classList.remove('hidden');
      } else if (fails >= 2) {
        win.textContent = "Game Over";
        win.classList.remove('hidden');
      } else {
        win.textContent = "“Thanks for playing my game.”";
      }
      spawnChunk();
      draw();
    }

    function spawnChunk() {
      const baseX = worldEnd;
      const gap = 60 + Math.random() * 40;
      const platCount = 3 + Math.floor(Math.random() * 2);
      const chunkLen = platCount * gap + 120;
      platforms.push({ x: baseX, y: 120, w: chunkLen, h: 20, type: 'solid', broken: false, drop: 0, t: 0, dir: 1, ox: baseX });
      for (let i = 0; i < platCount; i++) {
        const w = 40 + Math.random() * 50;
        const h = 8;
        const y = 70 + Math.random() * 40;
        const x = baseX + i * gap;
        const typeRoll = Math.random();
        let type = 'solid';
        if (typeRoll > 0.75) type = 'slide';
        if (typeRoll > 0.9) type = 'break';
        platforms.push({ x, y, w, h, type, t: 0, dir: Math.random() > 0.5 ? 1 : -1, ox: x, broken: false, drop: 0 });
        if (Math.random() > 0.3) {
          const isBonus = Math.random() > 0.82;
          coins.push({ x: x + w / 2, y: y - 12, r: 4, got: false, bonus: isBonus });
        }
        if (Math.random() > 0.6) {
          enemies.push({ x: x + 10, y: 108, w: 10, h: 10, dir: Math.random() > 0.5 ? 1 : -1, min: x - 10, max: x + w + 10, alive: true });
        }
        if (Math.random() > 0.75) {
          springs.push({ x: x + w / 2 - 4, y: y - 6, w: 8, h: 6 });
        }
      }
      worldEnd = baseX + chunkLen;
      platforms = platforms.filter(p => p.x + p.w > cameraX - 200);
      coins = coins.filter(c => c.x > cameraX - 200);
      enemies = enemies.filter(e => e.x > cameraX - 200);
      springs = springs.filter(s => s.x > cameraX - 200);
    }

    function rectsOverlap(a, b) {
      return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
    }

    function update() {
      player.vx = 0;
      if (keys.has('ArrowLeft') || keys.has('a')) player.vx = -speed;
      if (keys.has('ArrowRight') || keys.has('d')) player.vx = speed;
      if (charging && player.onGround) {
        jumpCharge = Math.min(maxCharge, jumpCharge + 1);
      }

      player.vy += gravity;
      player.x += player.vx;
      player.y += player.vy;

      if (player.x < 0) player.x = 0;

      player.onGround = false;
      platforms.forEach(p => {
        const py = p.y + (p.drop || 0);
        if (p.type === 'break' && p.broken && p.drop > 2) return;
        const hit = rectsOverlap(player, { x: p.x, y: py, w: p.w, h: p.h });
        if (hit) {
          if (player.vy > 0 && player.y + player.h - player.vy <= py) {
            player.y = py - player.h;
            player.vy = 0;
            player.onGround = true;
            if (p.type === 'break') {
              p.broken = true;
            }
          }
        }
      });

      if (!player.onGround) {
        charging = false;
        jumpCharge = 0;
      }

      coins.forEach(c => {
        if (!c.got) {
          const dx = player.x + player.w / 2 - c.x;
          const dy = player.y + player.h / 2 - c.y;
          if (Math.hypot(dx, dy) < c.r + 6) {
            c.got = true;
            collected += c.bonus ? 2 : 1;
            if (collected % 5 === 0) {
              colorTimer = 180;
            }
            if (collected >= 10) {
              running = false;
              win.classList.remove('hidden');
              triggerConfetti();
            }
          }
        }
      });

      enemies.forEach(e => {
        if (!e.alive) return;
        e.x += e.dir * 0.25;
        if (e.x < e.min || e.x > e.max) e.dir *= -1;
        if (rectsOverlap(player, e)) {
          const playerBottom = player.y + player.h;
          if (player.vy > 0 && playerBottom - player.vy <= e.y + 2) {
            e.alive = false;
            player.vy = jump * 0.6;
          } else {
            handleDeath();
          }
        }
      });

      // Boss spawns after collecting enough coins
      if (!boss.active && collected >= 10) {
        boss.active = true;
        boss.tier = collected >= 20 ? 2 : 1;
        boss.timer = boss.tier === 2 ? 480 : 320;
        boss.w = boss.tier === 2 ? 36 : 28;
        boss.h = boss.tier === 2 ? 36 : 28;
        boss.speed = boss.tier === 2 ? 1.0 : 0.8;
        boss.jump = boss.tier === 2 ? -6.8 : -6.2;
        boss.x = Math.max(0, cameraX - 30);
        boss.y = 120 - boss.h;
        boss.vy = 0;
        boss.onGround = false;
      }
      if (boss.active) {
        if (boss.tier === 1 && collected >= 20) {
          boss.tier = 2;
          boss.w = 36;
          boss.h = 36;
          boss.speed = 1.0;
          boss.jump = -6.8;
        }
        const dir = player.x > boss.x ? 1 : -1;
        boss.x += dir * boss.speed;
        boss.vy += gravity;
        boss.y += boss.vy;
        const bossGround = 120 - boss.h;
        if (boss.y >= bossGround) {
          boss.y = bossGround;
          boss.vy = 0;
          boss.onGround = true;
        } else {
          boss.onGround = false;
        }
        if (boss.onGround && Math.random() < (boss.tier === 2 ? 0.045 : 0.028)) {
          boss.vy = boss.jump;
          boss.onGround = false;
        }
        boss.timer -= 1;
        if (rectsOverlap(player, boss)) {
          handleDeath();
        }
        if (boss.timer <= 0) {
          boss.active = false;
        }
      }

      platforms.forEach(p => {
        if (p.type === 'slide') {
          p.t += 0.02;
          p.x = p.ox + Math.sin(p.t) * 16 * p.dir;
        }
        if (p.type === 'break' && p.broken) {
          p.drop += 0.9;
        }
      });

      meteors.forEach(m => {
        m.x -= m.vx;
        m.y += m.vy;
      });
      meteors = meteors.filter(m => m.x > cameraX - 80 && m.y < gameHeight + 40);
      if (Math.random() < 0.015) {
        meteors.push({ x: cameraX + gameWidth + 20, y: 10 + Math.random() * 30, vx: 2 + Math.random() * 1.5, vy: 1 + Math.random() * 1.5 });
      }

      cameraX = Math.max(0, player.x - gameWidth / 2);
      if (player.x + gameWidth > worldEnd - 200) {
        spawnChunk();
      }
      if (colorTimer > 0) colorTimer -= 1;
    }

    function draw() {
      ctx.clearRect(0, 0, gameWidth, gameHeight);
      const gradient = ctx.createLinearGradient(0, 0, 0, gameHeight);
      gradient.addColorStop(0, '#0b1022');
      gradient.addColorStop(1, '#111827');
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, gameWidth, gameHeight);
      ctx.save();
      ctx.translate(-cameraX * 0.2, 0);
      nebulas.forEach(n => {
        ctx.fillStyle = `rgba(99,102,241,${n.a})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();
      });
      stars.forEach(s => {
        ctx.fillStyle = `rgba(255,255,255,${s.a})`;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.restore();
      ctx.save();
      ctx.translate(-cameraX, 0);

      platforms.forEach(p => {
        const y = p.y + (p.drop || 0);
        ctx.shadowColor = 'rgba(139, 92, 246, 0.95)';
        ctx.shadowBlur = 18;
        ctx.fillStyle = p.type === 'break' ? 'rgba(248, 113, 113, 0.28)' : 'rgba(129, 140, 248, 0.28)';
        ctx.fillRect(p.x, y, p.w, p.h);
        ctx.shadowBlur = 24;
        ctx.globalAlpha = 0.35;
        ctx.fillRect(p.x - 1, y - 1, p.w + 2, p.h + 2);
        ctx.globalAlpha = 1;
        ctx.shadowBlur = 0;
        ctx.fillStyle = 'rgba(224, 231, 255, 0.9)';
        ctx.fillRect(p.x, y, p.w, 1.8);
        ctx.fillStyle = 'rgba(99, 102, 241, 0.35)';
        ctx.fillRect(p.x + 4, y + 3, p.w - 8, 1);
      });
      coins.forEach(c => {
        if (c.got) return;
        ctx.beginPath();
        ctx.fillStyle = c.bonus ? 'rgba(236, 72, 153, 0.95)' : 'rgba(255, 193, 7, 0.9)';
        ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
        ctx.fill();
      });

      springs.forEach(s => {
        ctx.fillStyle = 'rgba(34, 211, 238, 0.9)';
        ctx.fillRect(s.x, s.y, s.w, s.h);
        ctx.fillStyle = 'rgba(186, 230, 253, 0.9)';
        ctx.fillRect(s.x + 2, s.y + 1, s.w - 4, 2);
      });

      meteors.forEach(m => {
        ctx.strokeStyle = 'rgba(125, 211, 252, 0.6)';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(m.x, m.y);
        ctx.lineTo(m.x - 10, m.y - 6);
        ctx.stroke();
      });

      enemies.forEach(e => {
        if (!e.alive) return;
        ctx.fillStyle = 'rgba(239, 68, 68, 0.9)';
        ctx.fillRect(e.x, e.y, e.w, e.h);
        ctx.fillStyle = 'rgba(0,0,0,0.6)';
        ctx.fillRect(e.x + 2, e.y + 3, 2, 2);
        ctx.fillRect(e.x + 6, e.y + 3, 2, 2);
      });

      if (boss.active) {
        ctx.fillStyle = boss.tier === 2 ? 'rgba(16, 185, 129, 0.9)' : 'rgba(147, 51, 234, 0.9)';
        ctx.fillRect(boss.x, boss.y, boss.w, boss.h);
        ctx.fillStyle = 'rgba(0,0,0,0.7)';
        ctx.fillRect(boss.x + 6, boss.y + 6, 3, 3);
        ctx.fillRect(boss.x + 18, boss.y + 6, 3, 3);
      }

      // pixel character
      const color = colorTimer > 0 ? colors[Math.floor((colorTimer / 10) % colors.length)] : '#1d4ed8';
      ctx.fillStyle = color;
      ctx.fillRect(player.x, player.y, player.w, player.h);
      if (lives === 2 && !player.onGround) {
        ctx.save();
        ctx.shadowColor = 'rgba(34, 211, 238, 0.8)';
        ctx.shadowBlur = 10;
        ctx.fillStyle = 'rgba(34, 211, 238, 0.7)';
        ctx.fillRect(player.x - 3, player.y + 4, 2, 2);
        ctx.fillRect(player.x - 6, player.y + 6, 2, 2);
        ctx.restore();
      }
      ctx.fillStyle = '#f59e0b';
      ctx.fillRect(player.x + 2, player.y - 2, 6, 4);
      ctx.fillStyle = '#111827';
      ctx.fillRect(player.x + 2, player.y + 4, 2, 2);
      ctx.fillRect(player.x + 6, player.y + 4, 2, 2);

      ctx.restore();

      ctx.save();
      ctx.fillStyle = 'rgba(255,255,255,0.88)';
      ctx.font = '11px system-ui, sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(`◉ ${collected}`, 8, 14);
      ctx.textAlign = 'right';
      ctx.fillText(`♥ ${lives}`, gameWidth - 8, 14);
      ctx.restore();

      if (!running && collected >= 10) {
        ctx.save();
        ctx.fillStyle = '#22d3ee';
        ctx.shadowColor = 'rgba(34, 211, 238, 0.9)';
        ctx.shadowBlur = 12;
        ctx.font = 'bold 12px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Thanks for playing my game.', gameWidth / 2, 24);
        ctx.restore();
      }

      if (showFailGlow && failGlowTimer > 0) {
        ctx.save();
        ctx.fillStyle = '#f97316';
        ctx.shadowColor = 'rgba(249, 115, 22, 0.9)';
        ctx.shadowBlur = 18;
        ctx.font = 'bold 28px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('菜', gameWidth / 2, 62);
        ctx.restore();
        failGlowTimer -= 1;
        if (failGlowTimer <= 0) {
          showFailGlow = false;
        }
      }

      if (gameOver) {
        ctx.save();
        ctx.fillStyle = 'rgba(15, 23, 42, 0.6)';
        ctx.fillRect(0, 0, gameWidth, gameHeight);
        ctx.fillStyle = '#fff';
        ctx.shadowColor = 'rgba(34, 211, 238, 0.8)';
        ctx.shadowBlur = 10;
        ctx.font = 'bold 14px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Game Over', gameWidth / 2, 72);
        ctx.restore();
      }
    }

    function loop() {
      if (!running) return;
      update();
      draw();
      requestAnimationFrame(loop);
    }

    startBtn.addEventListener('click', () => {
      if (running) return;
      running = true;
      loop();
    });
    pauseBtn.addEventListener('click', () => {
      running = false;
    });
    resetBtn.addEventListener('click', () => {
      running = false;
      reset();
    });

    function isJumpKey(key) {
      return key === 'ArrowUp' || key === 'w' || key === ' ' || key === 'W';
    }

    window.addEventListener('keydown', (e) => {
      keys.add(e.key);
      if (isJumpKey(e.key) && player.onGround && !charging) {
        charging = true;
        jumpCharge = 0;
      }
    });
    window.addEventListener('keyup', (e) => {
      keys.delete(e.key);
      if (isJumpKey(e.key) && charging && player.onGround) {
        const ratio = Math.min(1, jumpCharge / maxCharge);
        const boosted = jump + (maxJump - jump) * ratio;
        player.vy = jumpCharge <= 2 ? jump : boosted;
        player.onGround = false;
      }
      if (isJumpKey(e.key)) {
        charging = false;
        jumpCharge = 0;
      }
    });

    function triggerConfetti() {
      const layer = document.createElement('div');
      layer.className = 'confetti-layer';
      const colors = ['#22d3ee', '#f472b6', '#a78bfa', '#facc15', '#34d399'];
      for (let i = 0; i < 40; i++) {
        const piece = document.createElement('i');
        const size = 4 + Math.random() * 6;
        piece.style.left = `${Math.random() * 100}%`;
        piece.style.width = `${size}px`;
        piece.style.height = `${size * 1.6}px`;
        piece.style.background = colors[i % colors.length];
        piece.style.animationDelay = `${Math.random() * 0.6}s`;
        piece.style.animationDuration = `${2.5 + Math.random() * 1.5}s`;
        layer.appendChild(piece);
      }
      canvas.parentElement.appendChild(layer);
      setTimeout(() => layer.remove(), 6000);
    }

    reset();

    function handleDeath() {
      lives -= 1;
      if (lives > 0) {
        player.x = Math.max(cameraX + 20, 16);
        player.y = 96;
        player.vx = 0;
        player.vy = 0;
        showFailGlow = true;
        failGlowTimer = 140;
      } else {
        fails += 1;
        gameOver = true;
        running = false;
        draw();
      }
    }
  })();
</script>

<style is:inline>
  :global(widget-layout.graph-game-widget) {
    overflow: visible !important;
  }

  :global(widget-layout.graph-game-widget .collapse-wrapper) {
    overflow: visible !important;
    padding-bottom: 0.35rem;
  }

  #graph-game {
    position: relative;
  }
  #graph-game .confetti-layer {
    pointer-events: none;
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 5;
  }
  #graph-game .confetti-layer i {
    position: absolute;
    top: -10px;
    border-radius: 2px;
    opacity: 0.9;
    animation-name: confetti-fall;
    animation-timing-function: linear;
  }
  @keyframes confetti-fall {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    100% {
      transform: translateY(180px) rotate(220deg);
      opacity: 0;
    }
  }
</style>
