---
import WidgetLayout from "@/components/common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

const gameWidth = 260;
const gameHeight = 140;
const worldWidth = 520;
---

<WidgetLayout id="graph-game" name="跳台小游戏" class={className} style={style}>
  <div class="relative">
    <canvas id="mini-platformer" width={gameWidth} height={gameHeight} class="w-full h-[160px] rounded-lg border border-black/10 dark:border-white/15 bg-white/60 dark:bg-black/30"></canvas>
    <div class="mt-2 flex gap-2">
      <button id="mini-start" class="btn-plain h-8 px-3 rounded-lg text-xs">开始</button>
      <button id="mini-pause" class="btn-plain h-8 px-3 rounded-lg text-xs">暂停</button>
      <button id="mini-reset" class="btn-plain h-8 px-3 rounded-lg text-xs">重开</button>
    </div>
  </div>
</WidgetLayout>

<script is:inline define:vars={{ gameWidth, gameHeight, worldWidth }}>
  (function() {
    const canvas = document.getElementById('mini-platformer');
    const startBtn = document.getElementById('mini-start');
    const pauseBtn = document.getElementById('mini-pause');
    const resetBtn = document.getElementById('mini-reset');
    if (!canvas || !startBtn || !pauseBtn || !resetBtn) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const player = { x: 16, y: 96, w: 10, h: 12, vx: 0, vy: 0, onGround: false };
    const gravity = 0.6;
    const speed = 1.6;
    const jump = -7.2;
    let platforms = [
      { x: 0, y: 120, w: 400, h: 20 },
    ];
    let coins = [];
    let enemies = [];
    let running = false;
    let collected = 0;
    const keys = new Set();
    let jumpPressed = false;
    let cameraX = 0;
    let worldEnd = 400;
    let colorTimer = 0;
    const colors = ['#22c55e', '#3b82f6', '#f59e0b', '#ef4444', '#a855f7'];

    function reset() {
      player.x = 16; player.y = 96; player.vx = 0; player.vy = 0; player.onGround = false;
      platforms = [{ x: 0, y: 120, w: 400, h: 20 }];
      coins = [];
      enemies = [];
      worldEnd = 400;
      collected = 0;
      colorTimer = 0;
      spawnChunk();
      draw();
    }

    function spawnChunk() {
      const baseX = worldEnd;
      const gap = 60 + Math.random() * 40;
      const platCount = 3 + Math.floor(Math.random() * 2);
      for (let i = 0; i < platCount; i++) {
        const w = 40 + Math.random() * 50;
        const h = 8;
        const y = 70 + Math.random() * 40;
        const x = baseX + i * gap;
        platforms.push({ x, y, w, h });
        if (Math.random() > 0.3) {
          coins.push({ x: x + w / 2, y: y - 12, r: 4, got: false });
        }
        if (Math.random() > 0.6) {
          enemies.push({ x: x + 10, y: 108, w: 10, h: 10, dir: Math.random() > 0.5 ? 1 : -1, min: x - 10, max: x + w + 10, alive: true });
        }
      }
      worldEnd = baseX + platCount * gap + 120;
      platforms = platforms.filter(p => p.x + p.w > cameraX - 200);
      coins = coins.filter(c => c.x > cameraX - 200);
      enemies = enemies.filter(e => e.x > cameraX - 200);
    }

    function rectsOverlap(a, b) {
      return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
    }

    function update() {
      player.vx = 0;
      if (keys.has('ArrowLeft') || keys.has('a')) player.vx = -speed;
      if (keys.has('ArrowRight') || keys.has('d')) player.vx = speed;
      const wantsJump = keys.has('ArrowUp') || keys.has('w') || keys.has(' ');
      if (wantsJump && player.onGround && !jumpPressed) {
        player.vy = jump;
        player.onGround = false;
        jumpPressed = true;
      }
      if (!wantsJump) {
        jumpPressed = false;
      }

      player.vy += gravity;
      player.x += player.vx;
      player.y += player.vy;

      if (player.x < 0) player.x = 0;
      if (player.x + player.w > worldWidth) player.x = worldWidth - player.w;

      player.onGround = false;
      platforms.forEach(p => {
        if (rectsOverlap(player, p)) {
          if (player.vy > 0 && player.y + player.h - player.vy <= p.y) {
            player.y = p.y - player.h;
            player.vy = 0;
            player.onGround = true;
          }
        }
      });

      coins.forEach(c => {
        if (!c.got) {
          const dx = player.x + player.w / 2 - c.x;
          const dy = player.y + player.h / 2 - c.y;
          if (Math.hypot(dx, dy) < c.r + 6) {
            c.got = true;
            collected += 1;
            if (collected % 5 === 0) {
              colorTimer = 180;
            }
          }
        }
      });

      enemies.forEach(e => {
        if (!e.alive) return;
        e.x += e.dir * 0.6;
        if (e.x < e.min || e.x > e.max) e.dir *= -1;
        if (rectsOverlap(player, e)) {
          const playerBottom = player.y + player.h;
          if (player.vy > 0 && playerBottom - player.vy <= e.y + 2) {
            e.alive = false;
            player.vy = jump * 0.6;
          } else {
            reset();
          }
        }
      });

      cameraX = Math.max(0, Math.min(worldWidth - gameWidth, player.x - gameWidth / 2));
      if (player.x + gameWidth > worldEnd - 120) {
        spawnChunk();
      }
      if (colorTimer > 0) colorTimer -= 1;
    }

    function draw() {
      ctx.clearRect(0, 0, gameWidth, gameHeight);
      ctx.save();
      ctx.translate(-cameraX, 0);

      ctx.fillStyle = 'rgba(0,0,0,0.1)';
      platforms.forEach(p => ctx.fillRect(p.x, p.y, p.w, p.h));
      coins.forEach(c => {
        if (c.got) return;
        ctx.beginPath();
        ctx.fillStyle = 'rgba(255, 193, 7, 0.9)';
        ctx.arc(c.x, c.y, c.r, 0, Math.PI * 2);
        ctx.fill();
      });

      enemies.forEach(e => {
        if (!e.alive) return;
        ctx.fillStyle = 'rgba(239, 68, 68, 0.9)';
        ctx.fillRect(e.x, e.y, e.w, e.h);
        ctx.fillStyle = 'rgba(0,0,0,0.6)';
        ctx.fillRect(e.x + 2, e.y + 3, 2, 2);
        ctx.fillRect(e.x + 6, e.y + 3, 2, 2);
      });

      // pixel character
      const color = colorTimer > 0 ? colors[Math.floor((colorTimer / 10) % colors.length)] : '#1d4ed8';
      ctx.fillStyle = color;
      ctx.fillRect(player.x, player.y, player.w, player.h);
      ctx.fillStyle = '#f59e0b';
      ctx.fillRect(player.x + 2, player.y - 2, 6, 4);
      ctx.fillStyle = '#111827';
      ctx.fillRect(player.x + 2, player.y + 4, 2, 2);
      ctx.fillRect(player.x + 6, player.y + 4, 2, 2);

      ctx.restore();
    }

    function loop() {
      if (!running) return;
      update();
      draw();
      requestAnimationFrame(loop);
    }

    startBtn.addEventListener('click', () => {
      if (running) return;
      running = true;
      loop();
    });
    pauseBtn.addEventListener('click', () => {
      running = false;
    });
    resetBtn.addEventListener('click', () => {
      running = false;
      reset();
    });

    window.addEventListener('keydown', (e) => keys.add(e.key));
    window.addEventListener('keyup', (e) => keys.delete(e.key));

    reset();
  })();
</script>
