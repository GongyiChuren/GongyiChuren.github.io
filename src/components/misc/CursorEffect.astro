---
// Background graph field + simple cursor trail
---

<canvas id="bg-graph-field" aria-hidden="true"></canvas>
<div id="cursor-core" aria-hidden="true"></div>
<div id="cursor-halo" aria-hidden="true"></div>

<style is:global>
  #bg-graph-field {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 20;
    opacity: 0.95;
  }

  #cursor-core,
  #cursor-halo {
    position: fixed;
    left: 0;
    top: 0;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease;
    z-index: 10000;
  }

  #cursor-core {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: hsl(var(--hue), 84%, 64%);
    box-shadow: 0 0 8px hsl(var(--hue), 84%, 64%);
  }

  #cursor-halo {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    border: 1.5px solid hsl(var(--hue), 84%, 64%);
    box-shadow: 0 0 14px color-mix(in srgb, var(--primary) 30%, transparent);
  }

  .cursor-trail-dot {
    position: fixed;
    pointer-events: none;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: hsl(var(--hue), 78%, 62%);
    box-shadow: 0 0 6px hsl(var(--hue), 78%, 62%);
    transform: translate(-50%, -50%);
    z-index: 10001;
    animation: cursor-trail-fade 0.42s ease-out forwards;
  }

  @keyframes cursor-trail-fade {
    from {
      opacity: 0.42;
      transform: translate(-50%, -50%) scale(1);
    }
    to {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.3);
    }
  }

  @media (max-width: 768px) {
    #bg-graph-field {
      opacity: 0.62;
    }

    #cursor-core,
    #cursor-halo {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #bg-graph-field {
      display: none;
    }

    #cursor-core,
    #cursor-halo {
      display: none;
    }
  }
</style>

<script>
  const runtime = ((window as any).__fireflyGraphRuntime ||= {
    initialized: false,
    rafId: 0,
  });

  if (!runtime.initialized) {
    runtime.initialized = true;

    const canvas = document.getElementById("bg-graph-field") as HTMLCanvasElement | null;
    const cursorCore = document.getElementById("cursor-core") as HTMLDivElement | null;
    const cursorHalo = document.getElementById("cursor-halo") as HTMLDivElement | null;
    if (!canvas) {
      runtime.initialized = false;
    } else {
      const ctx = canvas.getContext("2d", { alpha: true });
      if (!ctx) {
        runtime.initialized = false;
      } else {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const cursor = { x: 0, y: 0, active: false };
        let haloX = 0;
        let haloY = 0;
        const nodes: Array<{ x: number; y: number; vx: number; vy: number; r: number }> = [];
        let width = 0;
        let height = 0;
        let lastTrailAt = 0;
        let running = true;
        let frameCount = 0;

        const maxDist = 208;
        const breakRadius = 96;
        const repelDist = 34;
        const minSpeed = 0.09;
        const edgeFlashCycleMs = 9000;
        const edgeFlashDurationMs = 240;
        const clusterCount = 6;
        const cursorForceRadius = 110;
        let uiRects: Array<{ left: number; right: number; top: number; bottom: number }> = [];
        const anchors: Array<{ x: number; y: number; vx: number; vy: number }> = [];

        const rand = (min: number, max: number) => Math.random() * (max - min) + min;

        function updateUiRects() {
          const selectors = [
            "#top-row",
            "#navbar-wrapper",
            "#left-sidebar .card-base",
            "#right-sidebar .card-base",
            "#post-list-container .card-base",
            "#post-container .card-base",
            "#toc-wrapper",
            "footer",
            ".float-panel",
          ];

          const elements = document.querySelectorAll<HTMLElement>(selectors.join(","));
          const rects: Array<{ left: number; right: number; top: number; bottom: number }> = [];

          elements.forEach((element) => {
            const r = element.getBoundingClientRect();
            if (r.width < 8 || r.height < 8) return;
            if (r.bottom < 0 || r.top > window.innerHeight) return;
            rects.push({
              left: Math.max(0, r.left - 12),
              right: Math.min(window.innerWidth, r.right + 12),
              top: Math.max(0, r.top - 10),
              bottom: Math.min(window.innerHeight, r.bottom + 10),
            });
          });

          uiRects = rects;
        }

        function isInUi(x: number, y: number) {
          if (uiRects.length === 0) return false;
          for (let i = 0; i < uiRects.length; i++) {
            const r = uiRects[i];
            if (x >= r.left && x <= r.right && y >= r.top && y <= r.bottom) {
              return true;
            }
          }
          return false;
        }

        function samplePointPreferOutside() {
          const p = Math.random();
          let point: { x: number; y: number };

          // 下方区域更密
          if (p < 0.52) {
            point = { x: rand(0, width), y: rand(height * 0.68, height) };
          // 左右两侧更密
          } else if (p < 0.78) {
            if (Math.random() < 0.5) {
              point = { x: rand(0, width * 0.18), y: rand(height * 0.14, height) };
            } else {
              point = { x: rand(width * 0.82, width), y: rand(height * 0.14, height) };
            }
          // 顶部保留少量
          } else {
            point = { x: rand(0, width), y: rand(0, height * 0.26) };
          }

          if (!isInUi(point.x, point.y)) {
            return point;
          }

          for (let i = 0; i < 10; i++) {
            const retry = { x: rand(0, width), y: rand(0, height) };
            if (!isInUi(retry.x, retry.y)) return retry;
          }
          return point;
        }

        function ensureAnchors() {
          if (anchors.length === 0) {
            for (let i = 0; i < clusterCount; i++) {
              const p = samplePointPreferOutside();
              anchors.push({
                x: p.x,
                y: p.y,
                vx: rand(-0.22, 0.22),
                vy: rand(-0.22, 0.22),
              });
            }
          } else if (anchors.length > clusterCount) {
            anchors.length = clusterCount;
          }
        }

        function resize() {
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = Math.floor(width * dpr);
          canvas.height = Math.floor(height * dpr);
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

          updateUiRects();
          ensureAnchors();

          const targetCount = Math.max(280, Math.min(990, Math.floor((width * height) / 2900)));
          if (nodes.length < targetCount) {
            for (let i = nodes.length; i < targetCount; i++) {
              const p = samplePointPreferOutside();
              nodes.push({
                x: p.x,
                y: p.y,
                vx: rand(-0.4, 0.4),
                vy: rand(-0.4, 0.4),
                r: rand(1.4, 2.9),
              });
            }
          } else {
            nodes.length = targetCount;
          }
        }

        function distToSegment(px: number, py: number, ax: number, ay: number, bx: number, by: number) {
          const abx = bx - ax;
          const aby = by - ay;
          const apx = px - ax;
          const apy = py - ay;
          const ab2 = abx * abx + aby * aby || 1;
          const t = Math.max(0, Math.min(1, (apx * abx + apy * aby) / ab2));
          const cx = ax + abx * t;
          const cy = ay + aby * t;
          return Math.hypot(px - cx, py - cy);
        }

        function emitTrail(x: number, y: number) {
          if (window.innerWidth <= 768) return;
          const now = performance.now();
          if (now - lastTrailAt < 26) return;
          lastTrailAt = now;

          const dot = document.createElement("div");
          dot.className = "cursor-trail-dot";
          dot.style.left = `${x}px`;
          dot.style.top = `${y}px`;
          document.body.appendChild(dot);
          dot.addEventListener("animationend", () => dot.remove());
        }

        function animate() {
          if (!running) return;

          frameCount += 1;
          if (frameCount % 24 === 0) {
            updateUiRects();
          }

          ctx.clearRect(0, 0, width, height);
          const hue = Number.parseInt(getComputedStyle(document.documentElement).getPropertyValue("--hue").trim(), 10) || 205;
          const nowMs = performance.now();
          const flashPhase = nowMs % edgeFlashCycleMs;
          const edgeFlash = flashPhase < edgeFlashDurationMs
            ? Math.sin((flashPhase / edgeFlashDurationMs) * Math.PI) * 0.14
            : 0;

          if (cursorCore && cursorHalo) {
            haloX += (cursor.x - haloX) * 0.24;
            haloY += (cursor.y - haloY) * 0.24;
            cursorCore.style.left = `${cursor.x}px`;
            cursorCore.style.top = `${cursor.y}px`;
            cursorHalo.style.left = `${haloX}px`;
            cursorHalo.style.top = `${haloY}px`;
          }

          const t = performance.now() * 0.00038;

          for (let i = 0; i < anchors.length; i++) {
            const a = anchors[i];
            a.vx += rand(-0.008, 0.008);
            a.vy += rand(-0.008, 0.008);
            const as = Math.hypot(a.vx, a.vy);
            if (as > 0.3) {
              a.vx = (a.vx / as) * 0.3;
              a.vy = (a.vy / as) * 0.3;
            }
            a.x += a.vx;
            a.y += a.vy;
            if (a.x < 0 || a.x > width) a.vx *= -1;
            if (a.y < 0 || a.y > height) a.vy *= -1;
            a.x = Math.max(0, Math.min(width, a.x));
            a.y = Math.max(0, Math.min(height, a.y));
          }

          for (let i = 0; i < nodes.length; i++) {
            const n = nodes[i];

            // 轻流场，避免局部停滞
            n.vx += Math.sin(t + n.y * 0.012) * 0.005;
            n.vy += Math.cos(t + n.x * 0.012) * 0.005;

            // 多锚点吸引：形成多团动态簇，而不是两团
            let nearest = anchors[0];
            let nearestD2 = Number.POSITIVE_INFINITY;
            for (let k = 0; k < anchors.length; k++) {
              const a = anchors[k];
              const adx = a.x - n.x;
              const ady = a.y - n.y;
              const ad2 = adx * adx + ady * ady;
              if (ad2 < nearestD2) {
                nearestD2 = ad2;
                nearest = a;
              }
            }
            n.vx += (nearest.x - n.x) * 0.00075;
            n.vy += (nearest.y - n.y) * 0.00075;

            if (isInUi(n.x, n.y)) {
              const centerX = width * 0.5;
              const centerY = height * 0.5;
              const pushX = n.x - centerX || rand(-1, 1);
              const pushY = n.y - centerY || rand(-1, 1);
              const len = Math.hypot(pushX, pushY) || 1;
              n.vx += (pushX / len) * 0.03;
              n.vy += (pushY / len) * 0.03;
            }

            // 鼠标互动（除断线外）：靠近时节点被推开并带一点旋涡感
            if (cursor.active) {
              const mdx = n.x - cursor.x;
              const mdy = n.y - cursor.y;
              const md2 = mdx * mdx + mdy * mdy;
              if (md2 > 0 && md2 < cursorForceRadius * cursorForceRadius) {
                const md = Math.sqrt(md2);
                const nx = mdx / md;
                const ny = mdy / md;
                const f = (1 - md / cursorForceRadius) * 0.055;
                n.vx += nx * f - ny * f * 0.32;
                n.vy += ny * f + nx * f * 0.32;
              }
            }

            // 底部增强：上方节点缓慢下沉
            if (n.y < height * 0.8) {
              n.vy += 0.004;
            }

            // 顶部保留少量，不让全部下坠
            if (n.y < height * 0.16 && Math.random() < 0.18) {
              n.vy -= 0.005;
            }

            n.vx += rand(-0.012, 0.012);
            n.vy += rand(-0.012, 0.012);

            const speed = Math.hypot(n.vx, n.vy);
            if (speed > 0.55) {
              n.vx = (n.vx / speed) * 0.55;
              n.vy = (n.vy / speed) * 0.55;
            } else if (speed < minSpeed) {
              n.vx += rand(-0.035, 0.035);
              n.vy += rand(-0.035, 0.035);
            }

            n.x += n.vx;
            n.y += n.vy;

            if (n.x < 0) {
              n.x = 0;
              n.vx = Math.abs(n.vx) + rand(0.04, 0.1);
            }
            if (n.x > width) {
              n.x = width;
              n.vx = -Math.abs(n.vx) - rand(0.04, 0.1);
            }
            if (n.y < 0) {
              n.y = 0;
              n.vy = Math.abs(n.vy) + rand(0.03, 0.08);
            }
            if (n.y > height) {
              n.y = height;
              n.vy = -Math.abs(n.vy) - rand(0.03, 0.08);
            }

            n.x = Math.max(0, Math.min(width, n.x));
            n.y = Math.max(0, Math.min(height, n.y));
          }

          // 近邻排斥，防止节点聚成一坨
          for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
              const a = nodes[i];
              const b = nodes[j];
              const dx = b.x - a.x;
              const dy = b.y - a.y;
              const d2 = dx * dx + dy * dy;
              if (d2 === 0 || d2 > repelDist * repelDist) continue;

              const d = Math.sqrt(d2);
              const force = (1 - d / repelDist) * 0.019;
              const nx = dx / d;
              const ny = dy / d;

              a.vx -= nx * force;
              a.vy -= ny * force;
              b.vx += nx * force;
              b.vy += ny * force;
            }
          }

          for (let i = 0; i < nodes.length; i++) {
            for (let j = i + 1; j < nodes.length; j++) {
              const a = nodes[i];
              const b = nodes[j];
              const dx = b.x - a.x;
              const dy = b.y - a.y;
              const d2 = dx * dx + dy * dy;
              if (d2 > maxDist * maxDist) continue;

              if (cursor.active) {
                const dseg = distToSegment(cursor.x, cursor.y, a.x, a.y, b.x, b.y);
                if (dseg < breakRadius) continue;
              }

              const d = Math.sqrt(d2);

              // 轻微连线弹簧：运动规则依赖“线”，即使线不可见也成立
              if (d > 0) {
                const preferredDist = 118;
                const spring = ((d - preferredDist) / preferredDist) * 0.001;
                const nx = dx / d;
                const ny = dy / d;
                a.vx += nx * spring;
                a.vy += ny * spring;
                b.vx -= nx * spring;
                b.vy -= ny * spring;
              }

              const nearFactor = d < 18 ? d / 18 : 1;
              const alpha = Math.pow(1 - d / maxDist, 1.25) * 0.62 * nearFactor;
              const edgeSubset = ((i * 73856093) ^ (j * 19349663)) & 1;
              if (edgeFlash > 0.002 && edgeSubset === 0) {
                const flashAlpha = alpha * edgeFlash;
                ctx.strokeStyle = `hsla(${hue}, 88%, 70%, ${flashAlpha.toFixed(3)})`;
                ctx.lineWidth = 0.45;
                ctx.beginPath();
                ctx.moveTo(a.x, a.y);
                ctx.lineTo(b.x, b.y);
                ctx.stroke();
              }
            }
          }

          for (let i = 0; i < nodes.length; i++) {
            const n = nodes[i];
            ctx.fillStyle = `hsla(${hue}, 92%, 70%, 0.82)`;
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
            ctx.fill();
          }

          runtime.rafId = requestAnimationFrame(animate);
        }

        const onMove = (e: MouseEvent) => {
          cursor.x = e.clientX;
          cursor.y = e.clientY;
          cursor.active = true;
          if (cursorCore && cursorHalo) {
            cursorCore.style.opacity = "1";
            cursorHalo.style.opacity = "1";
          }
          emitTrail(cursor.x, cursor.y);
        };

        const onLeave = () => {
          cursor.active = false;
          if (cursorCore && cursorHalo) {
            cursorCore.style.opacity = "0";
            cursorHalo.style.opacity = "0";
          }
        };

        const onVisibility = () => {
          if (document.hidden) {
            running = false;
            cancelAnimationFrame(runtime.rafId);
          } else {
            if (!running) {
              running = true;
              runtime.rafId = requestAnimationFrame(animate);
            }
          }
        };

        resize();
        window.addEventListener("resize", resize, { passive: true });
        document.addEventListener("mousemove", onMove, { passive: true });
        document.addEventListener("mouseleave", onLeave, { passive: true });
        window.addEventListener("blur", onLeave, { passive: true });
        document.addEventListener("visibilitychange", onVisibility, { passive: true });

        runtime.rafId = requestAnimationFrame(animate);
      }
    }
  }
</script>
