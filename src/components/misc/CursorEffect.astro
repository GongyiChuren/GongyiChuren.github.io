---
// 鼠标光标特效组件 + 点击涟漪特效
---

<div id="cursor-dot" class="cursor-dot"></div>
<div id="cursor-outline" class="cursor-outline"></div>
<div id="cursor-cone-orb" class="cursor-cone-orb"></div>

<style is:global>
  .cursor-dot,
  .cursor-outline,
  .cursor-cone-orb {
    pointer-events: none;
    position: fixed;
    top: 0;
    left: 0;
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease-in-out, transform 0.08s ease-in-out;
    will-change: transform;
    z-index: 10000;
  }

  .cursor-dot {
    width: 5px;
    height: 5px;
    background: hsl(var(--hue), 70%, 50%);
    box-shadow: 0 0 5px hsl(var(--hue), 70%, 50%);
  }

  .cursor-outline {
    width: 24px;
    height: 24px;
    border: 1.5px solid hsl(var(--hue), 70%, 50%);
    transition: opacity 0.2s ease-in-out, transform 0.08s ease-in-out, border-color 0.2s ease-in-out;
  }

  .cursor-cone-orb {
    width: clamp(240px, 24vw, 420px);
    height: clamp(240px, 24vw, 420px);
    z-index: 6;
    opacity: 0;
    filter: blur(0.8px) saturate(1.1);
    mix-blend-mode: soft-light;
    --orb-rot: 0deg;
    --orb-scale: 1;
    --orb-alpha: 0.24;
    transform: translate(-50%, -50%) scale(var(--orb-scale)) rotate(var(--orb-rot));
    transition: opacity 0.25s ease;
    background:
      radial-gradient(circle at center, hsla(calc(var(--hue) + 10), 96%, 72%, 0.12) 0%, hsla(calc(var(--hue) + 10), 96%, 72%, 0.04) 36%, transparent 64%),
      conic-gradient(
        from 8deg,
        hsla(calc(var(--hue) + 2), 95%, 70%, 0) 0deg,
        hsla(calc(var(--hue) + 2), 95%, 70%, var(--orb-alpha)) 24deg,
        hsla(calc(var(--hue) + 2), 95%, 70%, 0) 56deg,
        hsla(calc(var(--hue) + 95), 95%, 72%, var(--orb-alpha)) 92deg,
        hsla(calc(var(--hue) + 95), 95%, 72%, 0) 130deg,
        hsla(calc(var(--hue) + 152), 95%, 72%, var(--orb-alpha)) 168deg,
        hsla(calc(var(--hue) + 152), 95%, 72%, 0) 206deg,
        hsla(calc(var(--hue) + 214), 95%, 74%, var(--orb-alpha)) 246deg,
        hsla(calc(var(--hue) + 214), 95%, 74%, 0) 286deg,
        hsla(calc(var(--hue) + 274), 95%, 74%, var(--orb-alpha)) 324deg,
        hsla(calc(var(--hue) + 274), 95%, 74%, 0) 360deg
      );
    mask-image: radial-gradient(circle at center, black 0%, black 16%, rgba(0, 0, 0, 0.5) 48%, transparent 82%);
    -webkit-mask-image: radial-gradient(circle at center, black 0%, black 16%, rgba(0, 0, 0, 0.5) 48%, transparent 82%);
  }

  .click-burst {
    position: fixed;
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 9999;
  }

  .click-ring {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    border: 2px solid hsl(var(--hue), 78%, 58%);
    transform: translate(-50%, -50%) scale(0.5);
    opacity: 0.85;
    animation: click-ring-out 0.52s cubic-bezier(0.2, 0.6, 0.2, 1) forwards;
  }

  .click-core {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: hsl(var(--hue), 82%, 62%);
    box-shadow: 0 0 10px hsl(var(--hue), 82%, 62%);
    transform: translate(-50%, -50%) scale(1);
    opacity: 0.9;
    animation: click-core-pop 0.34s ease-out forwards;
  }

  .click-spark {
    position: absolute;
    width: 6px;
    height: 2px;
    border-radius: 999px;
    background: hsl(var(--spark-hue, var(--hue)), 90%, 68%);
    transform: translate(-50%, -50%) rotate(var(--spark-angle)) translateX(0);
    opacity: 0.95;
    animation: click-spark-fly 0.5s ease-out forwards;
  }

  @keyframes click-ring-out {
    0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0.85; }
    100% { transform: translate(-50%, -50%) scale(4.2); opacity: 0; }
  }

  @keyframes click-core-pop {
    0% { transform: translate(-50%, -50%) scale(0.8); opacity: 1; }
    100% { transform: translate(-50%, -50%) scale(1.8); opacity: 0; }
  }

  @keyframes click-spark-fly {
    0% { transform: translate(-50%, -50%) rotate(var(--spark-angle)) translateX(0); opacity: 0.95; }
    100% { transform: translate(-50%, -50%) rotate(var(--spark-angle)) translateX(var(--spark-distance, 24px)); opacity: 0; }
  }

  /* 隐藏在移动设备上 */
  @media (max-width: 768px) {
    .cursor-dot,
    .cursor-outline,
    .cursor-cone-orb {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-cone-orb {
      display: none;
    }
  }
</style>

<script>
  const cursorRuntime = ((window as any).__fireflyCursorRuntime ||= {
    initialized: false,
    clickRippleBound: false,
    clickHandler: null,
  });

  const cursorDot = document.getElementById('cursor-dot');
  const cursorOutline = document.getElementById('cursor-outline');
  const cursorConeOrb = document.getElementById('cursor-cone-orb');

  if (!cursorRuntime.initialized && cursorDot && cursorOutline && cursorConeOrb) {
    cursorRuntime.initialized = true;

    let mouseX = 0;
    let mouseY = 0;
    let outlineX = 0;
    let outlineY = 0;
    let orbX = 0;
    let orbY = 0;
    let orbRot = 0;
    let orbScale = 1;
    let orbScaleTarget = 1;
    let orbAlpha = 0.36;
    let orbAlphaTarget = 0.36;
    let orbSpinBoost = 0;
    let orbDriftX = 0;
    let orbDriftY = 0;
    let prevMouseX = 0;
    let prevMouseY = 0;
    let lastMoveAt = 0;
    let isOverComment = false;
    let commentTarget: Element | null = null;
    let cachedRect: DOMRect | null = null;
    let rectTime = 0;
    const idleHideDelayMs = 140;
    const rectCacheMs = 120;

    const showCursor = () => {
      cursorDot.style.opacity = '1';
      cursorOutline.style.opacity = '1';
      cursorConeOrb.style.opacity = '1';
    };

    const hideCursor = () => {
      cursorDot.style.opacity = '0';
      cursorOutline.style.opacity = '0';
      cursorConeOrb.style.opacity = '0';
    };

    const onHoverIn = () => {
      cursorOutline.style.transform = 'translate(-50%, -50%) scale(1.35)';
      cursorOutline.style.borderWidth = '3px';
    };

    const onHoverOut = () => {
      cursorOutline.style.transform = 'translate(-50%, -50%) scale(1)';
      cursorOutline.style.borderWidth = '2px';
    };

    const bindHoverElements = (root: ParentNode) => {
      const elements = root.querySelectorAll('a, button, [role="button"]');
      elements.forEach((el) => {
        const htmlEl = el as HTMLElement;
        if (htmlEl.dataset.cursorListenerAdded) return;
        htmlEl.dataset.cursorListenerAdded = 'true';
        htmlEl.addEventListener('mouseenter', onHoverIn);
        htmlEl.addEventListener('mouseleave', onHoverOut);
      });
    };

    const bindHoverHideTargets = (root: ParentNode = document) => {
      const targets = root.querySelectorAll('iframe, giscus-widget, [data-cursor-hide]');
      targets.forEach((target) => {
        const htmlTarget = target as HTMLElement;
        if (htmlTarget.dataset.cursorVisibilityAdded) return;
        htmlTarget.dataset.cursorVisibilityAdded = 'true';
        htmlTarget.addEventListener('mouseenter', hideCursor);
        htmlTarget.addEventListener('mouseleave', showCursor);
      });
      commentTarget = document.querySelector('[data-cursor-hide]');
      cachedRect = null;
    };

    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      lastMoveAt = performance.now();

      const speed = Math.min(7, Math.hypot(mouseX - prevMouseX, mouseY - prevMouseY));
      const deltaX = mouseX - prevMouseX;
      const deltaY = mouseY - prevMouseY;
      prevMouseX = mouseX;
      prevMouseY = mouseY;
      orbScaleTarget = 1 + speed * 0.008;
      orbAlphaTarget = Math.min(0.38, 0.2 + speed * 0.018);
      orbSpinBoost = Math.min(1.0, orbSpinBoost + speed * 0.035);
      orbDriftX = Math.max(-9, Math.min(9, orbDriftX + deltaX * 0.14));
      orbDriftY = Math.max(-9, Math.min(9, orbDriftY + deltaY * 0.14));

      if (commentTarget) {
        const now = performance.now();
        if (!cachedRect || now - rectTime > rectCacheMs) {
          cachedRect = commentTarget.getBoundingClientRect();
          rectTime = now;
        }
        const padding = 18;
        isOverComment =
          mouseX >= cachedRect.left - padding &&
          mouseX <= cachedRect.right + padding &&
          mouseY >= cachedRect.top - padding &&
          mouseY <= cachedRect.bottom + padding;
      } else {
        isOverComment = false;
      }

      if (isOverComment) {
        hideCursor();
        return;
      }

      showCursor();
      cursorDot.style.left = `${mouseX}px`;
      cursorDot.style.top = `${mouseY}px`;
    });

    function animateOutline() {
      outlineX += (mouseX - outlineX) * 0.45;
      outlineY += (mouseY - outlineY) * 0.45;
      orbX += (mouseX - orbX) * 0.13;
      orbY += (mouseY - orbY) * 0.13;
      orbScale += (orbScaleTarget - orbScale) * 0.11;
      orbAlpha += (orbAlphaTarget - orbAlpha) * 0.08;
      orbSpinBoost *= 0.9;
      orbDriftX *= 0.84;
      orbDriftY *= 0.84;
      orbRot = (orbRot + 0.08 + orbSpinBoost * 0.5) % 360;

      cursorOutline.style.opacity = '1';
      cursorOutline.style.left = `${outlineX}px`;
      cursorOutline.style.top = `${outlineY}px`;
      cursorConeOrb.style.left = `${orbX + orbDriftX}px`;
      cursorConeOrb.style.top = `${orbY + orbDriftY}px`;
      cursorConeOrb.style.setProperty('--orb-rot', `${orbRot}deg`);
      cursorConeOrb.style.setProperty('--orb-scale', `${orbScale.toFixed(2)}`);
      cursorConeOrb.style.setProperty('--orb-alpha', orbAlpha.toFixed(2));

      if (isOverComment) {
        const now = performance.now();
        if (now - lastMoveAt > idleHideDelayMs) {
          hideCursor();
        }
      }

      requestAnimationFrame(animateOutline);
    }

    animateOutline();

    document.addEventListener('mouseenter', showCursor);
    document.addEventListener('mouseleave', hideCursor);
    window.addEventListener('blur', hideCursor);
    window.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget && !e.toElement) {
        hideCursor();
      }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) hideCursor();
    });

    document.addEventListener('mousedown', () => {
      cursorOutline.style.transform = 'translate(-50%, -50%) scale(0.8)';
    });

    document.addEventListener('mouseup', () => {
      cursorOutline.style.transform = 'translate(-50%, -50%) scale(1)';
    });

    bindHoverElements(document);
    bindHoverHideTargets(document);

    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        mutation.addedNodes.forEach((node) => {
          if (!(node instanceof HTMLElement)) return;
          bindHoverElements(node);
          bindHoverHideTargets(node);
        });
      }
    });

    observer.observe(document.body, { childList: true, subtree: true });
  }

  function createRipple(e: MouseEvent) {
    if (window.innerWidth <= 768) return;

    const burst = document.createElement('div');
    burst.className = 'click-burst';
    burst.style.left = `${e.clientX}px`;
    burst.style.top = `${e.clientY}px`;

    const ring = document.createElement('span');
    ring.className = 'click-ring';
    burst.appendChild(ring);

    const core = document.createElement('span');
    core.className = 'click-core';
    burst.appendChild(core);

    const sparks = 8;
    for (let i = 0; i < sparks; i++) {
      const spark = document.createElement('span');
      spark.className = 'click-spark';
      spark.style.setProperty('--spark-angle', `${(360 / sparks) * i}deg`);
      spark.style.setProperty('--spark-distance', `${18 + Math.random() * 14}px`);
      spark.style.setProperty('--spark-hue', `${(Number.parseInt(getComputedStyle(document.documentElement).getPropertyValue('--hue').trim(), 10) || 205) + i * 6}`);
      burst.appendChild(spark);
    }

    document.body.appendChild(burst);
    window.setTimeout(() => burst.remove(), 560);
  }

  if (cursorRuntime.clickHandler) {
    document.removeEventListener('click', cursorRuntime.clickHandler);
  }
  cursorRuntime.clickHandler = createRipple;
  cursorRuntime.clickRippleBound = true;
  document.addEventListener('click', cursorRuntime.clickHandler);
</script>
