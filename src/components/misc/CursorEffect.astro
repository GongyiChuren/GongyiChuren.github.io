---
// 鼠标光标特效组件
---

<div id="cursor-dot" class="cursor-dot"></div>
<div id="cursor-outline" class="cursor-outline"></div>

<style>
  .cursor-dot,
  .cursor-outline {
    pointer-events: none;
    position: fixed;
    top: 0;
    left: 0;
    border-radius: 50%;
    opacity: 0;
    transform: translate(-50%, -50%);
    transition: opacity 0.2s ease-in-out, transform 0.08s ease-in-out;
    will-change: transform;
    z-index: 10000;
  }

  .cursor-dot {
    width: 6px;
    height: 6px;
    background: hsl(var(--hue), 70%, 50%);
    box-shadow: 0 0 6px hsl(var(--hue), 70%, 50%);
  }

  .cursor-outline {
    width: 28px;
    height: 28px;
    border: 2px solid hsl(var(--hue), 70%, 50%);
    transition: opacity 0.2s ease-in-out, transform 0.08s ease-in-out, border-color 0.2s ease-in-out;
  }

  /* 隐藏在移动设备上 */
  @media (max-width: 768px) {
    .cursor-dot,
    .cursor-outline {
      display: none;
    }
  }
</style>

<script>
  const cursorDot = document.getElementById('cursor-dot');
  const cursorOutline = document.getElementById('cursor-outline');

  if (cursorDot && cursorOutline) {
    let mouseX = 0;
    let mouseY = 0;
    let outlineX = 0;
    let outlineY = 0;
    let lastMoveAt = 0;
    let isOverComment = false;
    const idleHideDelayMs = 140;

    const showCursor = () => {
      cursorDot.style.opacity = '1';
      cursorOutline.style.opacity = '1';
    };

    const hideCursor = () => {
      cursorDot.style.opacity = '0';
      cursorOutline.style.opacity = '0';
    };

    const bindHoverHideTargets = () => {
      const targets = document.querySelectorAll('iframe, giscus-widget, [data-cursor-hide]');
      targets.forEach((target) => {
        if (!target.dataset.cursorVisibilityAdded) {
          target.dataset.cursorVisibilityAdded = 'true';
          target.addEventListener('mouseenter', hideCursor);
          target.addEventListener('mouseleave', showCursor);
        }
      });
    };

    // 鼠标移动事件
    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      lastMoveAt = performance.now();

      const commentTarget = document.querySelector('[data-cursor-hide]');
      if (commentTarget) {
        const rect = commentTarget.getBoundingClientRect();
        const padding = 18;
        isOverComment =
          mouseX >= rect.left - padding &&
          mouseX <= rect.right + padding &&
          mouseY >= rect.top - padding &&
          mouseY <= rect.bottom + padding;
      } else {
        isOverComment = false;
      }

      if (isOverComment) {
        hideCursor();
        return;
      }

      // 立即更新点的位置
      showCursor();
      cursorDot.style.left = `${mouseX}px`;
      cursorDot.style.top = `${mouseY}px`;
    });

    // 平滑跟随的外圈
    function animateOutline() {
      // 缓动效果 - 增加系数从 0.15 到 0.25 加快跟随速度
      outlineX += (mouseX - outlineX) * 0.45;
      outlineY += (mouseY - outlineY) * 0.45;

      cursorOutline.style.opacity = '1';
      cursorOutline.style.left = `${outlineX}px`;
      cursorOutline.style.top = `${outlineY}px`;

      if (isOverComment) {
        const now = performance.now();
        if (now - lastMoveAt > idleHideDelayMs) {
          hideCursor();
        }
      }

      requestAnimationFrame(animateOutline);
    }

    animateOutline();

    // 鼠标进入页面
    document.addEventListener('mouseenter', showCursor);

    // 鼠标离开页面
    document.addEventListener('mouseleave', hideCursor);
    window.addEventListener('blur', hideCursor);
    window.addEventListener('mouseout', (e) => {
      if (!e.relatedTarget && !e.toElement) {
        hideCursor();
      }
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) hideCursor();
    });

    // 鼠标按下时缩小外圈
    document.addEventListener('mousedown', () => {
      if (cursorOutline) {
        cursorOutline.style.transform = 'translate(-50%, -50%) scale(0.8)';
      }
    });

    // 鼠标松开时恢复外圈
    document.addEventListener('mouseup', () => {
      if (cursorOutline) {
        cursorOutline.style.transform = 'translate(-50%, -50%) scale(1)';
      }
    });

    // 悬停在链接或按钮上时放大外圈
    const hoverElements = document.querySelectorAll('a, button, [role="button"]');
    hoverElements.forEach((el) => {
      el.addEventListener('mouseenter', () => {
        if (cursorOutline) {
          cursorOutline.style.transform = 'translate(-50%, -50%) scale(1.35)';
          cursorOutline.style.borderWidth = '3px';
        }
      });

      el.addEventListener('mouseleave', () => {
        if (cursorOutline) {
          cursorOutline.style.transform = 'translate(-50%, -50%) scale(1)';
          cursorOutline.style.borderWidth = '2px';
        }
      });
    });

    // 监听动态添加的元素
    const observer = new MutationObserver(() => {
      const newHoverElements = document.querySelectorAll('a, button, [role="button"]');
      newHoverElements.forEach((el) => {
        if (!el.dataset.cursorListenerAdded) {
          el.dataset.cursorListenerAdded = 'true';

          el.addEventListener('mouseenter', () => {
            if (cursorOutline) {
              cursorOutline.style.transform = 'translate(-50%, -50%) scale(1.35)';
              cursorOutline.style.borderWidth = '3px';
            }
          });

          el.addEventListener('mouseleave', () => {
            if (cursorOutline) {
              cursorOutline.style.transform = 'translate(-50%, -50%) scale(1)';
              cursorOutline.style.borderWidth = '2px';
            }
          });
        }
      });
      bindHoverHideTargets();
    });

    bindHoverHideTargets();
    observer.observe(document.body, { childList: true, subtree: true });
  }
</script>
