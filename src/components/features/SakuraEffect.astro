---
import { sakuraConfig } from "@/config";
---

{sakuraConfig?.enable && (
  <script>
    import { initSakura } from "@/utils/sakura-manager";
    import { sakuraConfig } from "@/config";

    // 初始化函数
    function setupSakura() {
      initSakura(sakuraConfig);
    }

    // 立即初始化
    setupSakura();

    // 兼容 Astro View Transitions
    document.addEventListener('astro:page-load', setupSakura);
    
    // 兼容 Swup (如果项目中使用)
    // 根据 Layout.astro，项目似乎使用了 swup
    if (window.swup) {
      window.swup.hooks.on('content:replace', setupSakura);
    } else {
      document.addEventListener('swup:content:replace', setupSakura);
    }
  </script>
)}